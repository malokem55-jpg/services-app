{
  "manifest_version": 3,
  "name": "مساعد تسجيل دخول المؤسسات",
  "description": "يفتح صفحة تسجيل دخول المنصة (مقيم أو الغرفة التجارية) ويملأ اسم المستخدم وكلمة المرور ببيانات المؤسسة المختارة من نظام الخدمات. لا يضغط زر الدخول.",
  "version": "1.4.0",
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": [
        "http://localhost:5173/*",
        "http://localhost:4173/*",
        "http://127.0.0.1:5173/*",
        "http://127.0.0.1:4173/*",
        "https://kayan-sys.com/*",
        "https://www.kayan-sys.com/*"
      ],
      "js": ["content-app.js"],
      "run_at": "document_start"
    }
  ]
}
