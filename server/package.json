{
  "name": "services-app-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "prisma": "tsx scripts/prisma-cli.ts",
    "migrate": "tsx scripts/prisma-cli.ts migrate dev",
    "generate": "tsx scripts/prisma-cli.ts generate",
    "build": "tsx scripts/prisma-cli.ts generate && tsc",
    "start": "node dist/index.js",
    "deploy": "wrangler deploy",
    "seed:user": "tsx scripts/seed-user.ts",
    "reset:user": "tsx scripts/reset-password.ts",
    "seed:services": "tsx scripts/seed-services.ts",
    "seed:steps": "tsx scripts/seed-steps.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.2.1",
    "pg": "^8.13.0",
    "web-push": "^3.6.7",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.21",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.0",
    "@types/web-push": "^3.6.4",
    "mysql2": "^3.22.5",
    "prisma": "^7.8.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "wrangler": "^4.0.0"
  }
}
