{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hameed-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // حساب Cloudflare بلغ حدّ 5 كرون من مشاريع أخرى، فلا يقبل مؤقّتاً كرون hameed-api.
  // الحلّ لاحقاً: مُشغّل خارجي مجاني (cron-job.org) يستدعي نقطة داخلية كل 5 دقائق،
  // أو تحرير خانة كرون من مشروع غير مستخدم. النبضة (worker.ts scheduled) جاهزة.
  "triggers": { "crons": [] },

  // Hyperdrive الخاص بهذا المشروع (kayan-db) — يشير لنفس قاعدة Supabase المشتركة،
  // وسكيما hameed تعزل جداول هذا التطبيق.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "5a26f9261fda4b9fa7dfc0e87c92ff1a",
      // Local `wrangler dev` only — replace PASSWORD with the real one locally.
      "localConnectionString": "postgresql://postgres:PASSWORD@db.fzucyhatdwgqfdpuvlsp.supabase.co:5432/postgres"
    }
  ],

  "vars": {
    // Unique schema isolates this app's tables in the shared Supabase database.
    "DB_SCHEMA": "hameed",
    "APP_TIMEZONE": "Asia/Riyadh"
  }
  // Secrets (set via `wrangler secret put`):
  //   JWT_SECRET, VAPID_EMAIL, VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY,
  //   CREDENTIALS_ENCRYPTION_KEY
}
